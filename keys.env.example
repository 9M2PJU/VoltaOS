# ═══════════════════════════════════════════════════════════════════════
#  API KEYS for Volta OS
#
#  1. copy this file:      cp keys.env.example keys.env
#  2. paste your keys after the "=" (no quotes, no spaces)
#  3. restart the UI
#
#  keys.env must NEVER go on GitHub (it is already in .gitignore).
#  An environment variable with the same name takes precedence over the file.
#  Keys left empty only disable the feature that uses them.
# ═══════════════════════════════════════════════════════════════════════

# ── Maps ───────────────────────────────────────────────────────────────
# Mapbox (map style, routes, search)     https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=
# MapTiler (map style, satellite)         https://cloud.maptiler.com/account/keys/
MAPTILER_KEY=
# TomTom (place search)                   https://developer.tomtom.com/
TOMTOM_KEY=

# ── Weather ─────────────────────────────────────────────────────────────
# OpenWeatherMap                            https://home.openweathermap.org/api_keys
OWM_KEY=

# ── Spotify ────────────────────────────────────────────────────────────
# https://developer.spotify.com/dashboard  → create an app and add the Redirect URI
#   http://127.0.0.1:8098/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
